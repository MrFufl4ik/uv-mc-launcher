{
  "name": "uv-mc-launcher",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build-ts": "tsc",
    "build-es": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node26 --minify '--banner:js=import { createRequire } from \"node:module\"; const require = createRequire(import.meta.url);' --outfile=build/uv-mc-launcher.mjs",
    "build-sea": "node --build-sea sea-config.json",
    "build-icon-win32": "magick assets/uv-mv-launcher-icon.png -define icon:auto-resize=256,128,64,48,32,16 assets/uv-mv-launcher-icon.ico",
    "set-icon-win32": "node set-icon-win32.mjs",
    "build-sea-win32": "node --build-sea sea-config-win32.json",
    "build": "npm run build-ts && npm run build-es && npm run build-sea && npm run build-sea-win32 && npm run set-icon-win32 && npm run set-icon-win32",
    "test": "echo Das is good!"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^26.6.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/readline-sync": "^1.4.8",
    "@types/unzipper": "^0.10.11",
    "esbuild": "^0.28.2",
    "resedit": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "ci": "^2.3.0",
    "cli-progress": "^3.12.0",
    "proper-lockfile": "^4.1.2",
    "readable-stream": "^4.8.0",
    "readline-sync": "^1.4.10",
    "simple-git": "^4.0.2",
    "tar": "^7.5.22",
    "unzipper": "^0.12.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
